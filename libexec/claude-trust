#!/usr/bin/env python3
# Manage workspace trust in ~/.claude.json (as if the trust dialog was accepted).
# This relies on Claude Code's internal config format, not a documented interface.
#
# usage: claude-trust <path>...           trust folders
#        claude-trust --remove <path>...  stop trusting folders
#        claude-trust --check <path>...   print the folders that are trusted,
#                                         restoring any entry Claude Code dropped
#
# codehive keeps its own list of trusted folders next to this script's install
# (../trusted). Claude Code processes can drop entries when they rewrite
# ~/.claude.json, and --check puts back any folder on the list. --check also
# adds folders you trusted through Claude Code's dialog to the list.
import json, os, sys, tempfile

cfg = os.path.expanduser("~/.claude.json")
listfile = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "trusted")

mode = "trust"
args = sys.argv[1:]
if args and args[0] in ("--remove", "--check"):
    mode, args = args[0][2:], args[1:]

try:
    with open(cfg) as f:
        data = json.load(f)
except FileNotFoundError:
    sys.exit(f"claude-trust: {cfg} not found; run `claude` once first")
except json.JSONDecodeError as e:
    sys.exit(f"claude-trust: can't parse {cfg}: {e}")

try:
    with open(listfile) as f:
        listed = {line.strip() for line in f if line.strip()}
except FileNotFoundError:
    listed = set()
old_listed = set(listed)

def write_atomic(path, text, mode_from=None):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(fd, "w") as f:
        f.write(text)
    if mode_from and os.path.exists(mode_from):
        os.chmod(tmp, os.stat(mode_from).st_mode & 0o777)
    os.replace(tmp, path)

projects = data.setdefault("projects", {})
changed = False
for arg in args:
    d = os.path.realpath(arg)
    entry = projects.get(d, {})
    accepted = bool(entry.get("hasTrustDialogAccepted"))
    if mode == "remove":
        listed.discard(d)
        if accepted:
            del entry["hasTrustDialogAccepted"]
            changed = True
        continue
    if mode == "check" and not accepted and d not in listed:
        continue
    listed.add(d)
    if not accepted:
        projects.setdefault(d, entry)["hasTrustDialogAccepted"] = True
        changed = True
    if mode == "check":
        print(arg)

if changed:
    write_atomic(cfg, json.dumps(data, indent=2), mode_from=cfg)
if listed != old_listed:
    os.makedirs(os.path.dirname(listfile), exist_ok=True)
    write_atomic(listfile, "".join(f"{d}\n" for d in sorted(listed)))
