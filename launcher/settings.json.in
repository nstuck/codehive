{
  "permissions": {
    "allow": [@LAUNCHER_ALLOW@],
    "deny": [
      @LAUNCHER_DENY@
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "\"@LIBEXEC@/claude-rc-update-check\" --notice" }
        ]
      }
    ]
  }
}
